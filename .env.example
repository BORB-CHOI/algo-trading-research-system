# cp .env.example .env 후 값을 채운다. .env 는 커밋하지 않는다.

# OpenDART 인증키 — https://opendart.fss.or.kr (무료)
DART_API_KEY=

# marcap 위치. 기본값(data/marcap)이면 비워 둔다.
MARCAP_DIR=

# KRX 정보데이터시스템 Open API 인증키 — https://openapi.krx.co.kr (무료, 하루 10,000콜)
# 쓰임: marcap 뒤쪽 공백 채우기(날짜당 3콜) + 갱신 시작 때 마지막 거래일 판정(1콜). 조회 전용.
# 인증키 승인 뒤에도 API 마다 "활용신청 → 관리자 승인"이 따로 있다. 유가증권·코스닥·코넥스
# "일별매매정보" 3개가 승인돼야 한다 — 아니면 모든 호출이 401 Unauthorized API Call 이다.
KRX_AUTH_KEY=

# KIS(한국투자증권) 오픈API — https://apiportal.koreainvestment.com
# 주의: 실전과 모의투자는 앱키가 서로 다르다. 단계 5 는 모의투자만 쓴다.
# KIS_ENV=vts 면 모의(openapivts...:29443), real 이면 실전(openapi...:9443).
KIS_ENV=vts
KIS_APP_KEY=
KIS_APP_SECRET=
# VI처럼 종목별 조회가 많은 수집은 번호 키를 자동으로 병렬 사용한다(최대 _20).
KIS_APP_KEY_2=
KIS_APP_SECRET_2=
KIS_ACCOUNT_NO=        # 8자리-2자리 (예: 12345678-01)

# 나무증권(NH투자증권) PLUG 오픈API — https://www.nhplug.com
# 키는 운영·모의 공용. 토큰은 항상 운영(api)에서 발급된다(모의 서버는 토큰 미발급).
# 조회는 NHPLUG_BASE_URL 로 보낸다: 운영 https://api.nhplug.com:8443
#                                모의 https://moapi.nhplug.com:8443 (주문 검증은 반드시 모의부터)
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=
NHPLUG_BASE_URL=https://api.nhplug.com:8443

# 나무를 초당 몇 번까지 부를지. SDK 0.3.0 부터 이 값으로 스스로 속도를 조절한다.
# 안 적으면 초당 4회, 5회가 상한이다(그 위를 적어도 5로 깎인다).
# 실측 2026-08-28, 60종목 일봉을 5줄기로 받아 잰 값:
#   빈칸(초당 4회) → 초당 3.84건, 한도 거절 1/180
#   4.5           → 초당 4.43건, 한도 거절 0/60   ← 지금 이 값
#   SDK 0.2.1 + 우리 조절기만 → 초당 4.28건, 한도 거절 2/180
# 더 올려도 안 빨라진다(응답 기다리는 시간이 한도보다 길다). 낮추면 그만큼 느려진다.
NHPLUG_RATE_LIMIT=4.5

# 키움증권 REST API — https://openapi.kiwoom.com
# 아직 안 붙였다. 검토 중인 쓰임(2026-08-28): 수급을 종목마다(2,758콜) 말고
# 날짜마다 시장 전체로 받기(ka10062 동일순매매순위 · ka10058 투자자별일별매매종목).
# 키움 SDK 는 저작권이 키움에 있어 우리 저장소에 넣을 수 없다 — 우리가 직접 호출한다.
#
# ⚠️ 조회 전용. 주문·정정·취소 호출은 넣지 않는다(CLAUDE.md 매매 실행 경로 규칙).
# 한도: 국내주식 조회·주문 각 초당 5회. 9~10시에는 3회로 줄어든다.
# 이름 앞에 KIWOOM_ 을 붙인 이유 — 키움 공식 예제는 APP_KEY/APP_SECRET 을 그냥 쓰는데,
# 우리 .env 에는 KIS·나무 키가 이미 있어서 그대로 두면 서로 덮어쓴다.
KIWOOM_MODE=mock        # mock=모의투자, real=실전. 붙이는 동안은 모의로 둔다.
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_APP_KEY_MOCK=
KIWOOM_APP_SECRET_MOCK=
KIWOOM_BASE_URL=https://api.kiwoom.com        # 모의는 https://mockapi.kiwoom.com
KIWOOM_WS_URL=wss://api.kiwoom.com:10000      # 모의는 wss://mockapi.kiwoom.com:10000
