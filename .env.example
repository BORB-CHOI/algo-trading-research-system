# ─────────────────────────────────────────────────────────────
# 환경변수 예시 — 이 파일을 복사해 .env 로 쓴다.
#
#   cp .env.example .env   후 값을 채운다.
#
# .env 는 절대 커밋하지 않는다(.gitignore 등록됨). 키는 개인 자산이다.
# 여기 값은 전부 **조회·개발 보조용**이다. 주문·포지션 결정은 결정론적 코드가 한다(CLAUDE.md).
# ─────────────────────────────────────────────────────────────

# ── OpenDART (금융감독원 전자공시) — 재무제표 백필용 ─────────────
# 발급: https://opendart.fss.or.kr  (무료, 가입 후 인증키 신청 → 즉시 발급)
# 쓰는 곳: scripts/backfill_dart.py  (BORB-41 ② 재무분석 조건검색)
DART_API_KEY=

# ── 한국투자증권(KIS) OpenAPI — 조회 전용으로 시작 ───────────────
# 발급: https://apiportal.koreainvestment.com  → 앱키/앱시크릿 발급
#   · 모의투자(무료) 와 실전투자 키가 **각각 다르다**. 단계 6 전까지 실전 키 ❌.
#   · 쓰는 곳(예정): 지수·환율·업종·뉴스·투자자 매매동향 조회 (BORB-43)
# 주의: 트레이딩 MCP 는 매매 실행 경로에 연결하지 않는다(CLAUDE.md). 여기 키는 REST 조회용.
KIS_APP_KEY=
KIS_APP_SECRET=

# 모의투자 계좌번호 (8자리-2자리). 실전 계좌는 단계 6 전까지 넣지 않는다.
KIS_ACCOUNT_NO=
# paper = 모의투자(https://openapivts.koreainvestment.com:29443)
# real  = 실전투자(https://openapi.koreainvestment.com:9443) — 단계 6 이후에만
KIS_ENV=paper

# ── 로컬 데이터 경로 (기본값이면 비워 둔다) ──────────────────────
# marcap 클론 위치. 기본: <repo>/data/marcap
# MARCAP_DIR=
