# cp .env.example .env 후 값을 채운다. .env 는 커밋하지 않는다.

# OpenDART 인증키 — https://opendart.fss.or.kr (무료)
DART_API_KEY=

# marcap 위치. 기본값(data/marcap)이면 비워 둔다.
MARCAP_DIR=

# KIS(한국투자증권) 오픈API — https://apiportal.koreainvestment.com
# 주의: 실전과 모의투자는 앱키가 서로 다르다. 단계 5 는 모의투자만 쓴다.
# KIS_ENV=vts 면 모의(openapivts...:29443), real 이면 실전(openapi...:9443).
KIS_ENV=vts
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=        # 8자리-2자리 (예: 12345678-01)

# 나무증권(NH투자증권) PLUG 오픈API — https://www.nhplug.com
# 키는 운영·모의 공용. 토큰은 항상 운영(api)에서 발급된다(모의 서버는 토큰 미발급).
# 조회는 NHPLUG_BASE_URL 로 보낸다: 운영 https://api.nhplug.com:8443
#                                모의 https://moapi.nhplug.com:8443 (주문 검증은 반드시 모의부터)
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=
NHPLUG_BASE_URL=https://api.nhplug.com:8443
